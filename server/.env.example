# ===================================================
# CitySwap Backend Environment Variables Configuration
# ===================================================

# Application Info
PROJECT_NAME=CitySwap Backend
PROJECT_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Host & CORS Settings
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://your_user:your_secure_password@ep-your-project-id.region.neon.tech/neondb?sslmode=require

# Authentication & JWT Security
SECRET_KEY=replace_with_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload Directory & File Limits (10MB default)
# MEDIA_STORAGE_BACKEND: 'local' (default) or 'r2' (Cloudflare R2 for production)
MEDIA_STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Cloudflare R2 Object Storage (Required when MEDIA_STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ecopulse-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Meta WhatsApp Cloud API Settings
META_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set a private, unpredictable value in your local environment / deployment settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE=+919876543210
WHATSAPP_GRAPH_API_VERSION=v20.0

# Optional Twilio WhatsApp Provider (set the exact public HTTPS callback URL configured in Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-public-domain.example/api/whatsapp/twilio-webhook
