# =====================================================================
# EcoPulse AI — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =====================================================================

# ---------------------------------------------------------------------------
# Application environment (REQUIRED — startup fails if unset or unknown)
# ---------------------------------------------------------------------------
# Allowed values: development | dev | local | test | testing | staging | production
#
# Fail-closed policy (Phase 1G):
#   • An unset, empty, or unrecognized ENV is NEVER treated as "development".
#   • Unset ENV → startup aborts with a clear configuration error.
#   • Unknown ENV (e.g. "sandbox") → startup aborts; schema is never mutated.
#   • development / dev / local / test / testing → schema creation + demo seeding allowed.
#   • staging / production → read-only startup verification only; no DDL, no seeding.
ENV=development
# Backward-compatible alias (ENV takes precedence when both are set):
# ENVIRONMENT=development

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
PROJECT_NAME="EcoPulse AI API"
VERSION=1.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in staging and production. If omitted in development/test, SQLite is used.
# IMPORTANT: SQLite is never permitted in staging or production.
DATABASE_URL=postgresql://username:password@your-db-host.example:5432/ecopulse?sslmode=require

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Required in production — minimum 32 cryptographically random characters.
SECRET_KEY=replace_with_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# CORS (required in production — no localhost origins permitted)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://ecopulse-ai-frontend.onrender.com
# Backward-compatible alias: BACKEND_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Media / file storage
# ---------------------------------------------------------------------------
# MEDIA_STORAGE_BACKEND: 'local' (dev/test) | 'r2' (Cloudflare R2) | 'supabase'
MEDIA_STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Cloudflare R2 (required when MEDIA_STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ecopulse-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Supabase Storage (required when MEDIA_STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=complaint-images
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# WhatsApp — Meta Cloud API (primary provider)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
# Required in production for inbound webhook POST signature verification:
META_APP_SECRET=your_meta_app_secret
# Required for outbound message delivery:
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Required for Meta webhook GET verification handshake:
WHATSAPP_VERIFY_TOKEN=your_private_unpredictable_verify_token
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_GRAPH_API_VERSION=v22.0

# Optional Twilio provider (active ONLY when WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_WEBHOOK_URL=https://your-public-domain.example/api/whatsapp/twilio-webhook

# ---------------------------------------------------------------------------
# Meta WhatsApp OTP delivery
# ---------------------------------------------------------------------------
# OTP_DELIVERY_PROVIDER: 'meta_whatsapp' (production) | 'development' (dev/test mock)
# Defaults: production → meta_whatsapp; dev/test → development; unknown ENV → disabled
OTP_DELIVERY_PROVIDER=meta_whatsapp
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
META_OTP_TEMPLATE_NAME=ecopulse_otp
META_OTP_TEMPLATE_LANGUAGE=en
META_GRAPH_API_VERSION=v22.0
META_OTP_TEMPLATE_CATEGORY=AUTHENTICATION
META_OTP_TEMPLATE_HAS_BUTTON=true
META_OTP_TEMPLATE_HAS_URL_BUTTON=true

# ---------------------------------------------------------------------------
# SMS / Mobile OTP (Indian DLT-compliant gateway)
# ---------------------------------------------------------------------------
# SMS_PROVIDER: 'msg91' (production) | 'mock' (dev/test) | 'disabled' (unknown ENV)
SMS_PROVIDER=msg91
SMS_API_KEY=your_msg91_api_key
SMS_SENDER_ID=ECPULS
SMS_TEMPLATE_ID=your_dlt_template_id
SMS_OTP_EXPIRY_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# MFA — Authenticator App (TOTP) — REQUIRED in production
# ---------------------------------------------------------------------------
# Generate a valid Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=your_fernet_key_replace_before_production

# ---------------------------------------------------------------------------
# IAM — Municipal Employee Allowlist (REQUIRED in production)
# ---------------------------------------------------------------------------
# Comma-separated list of approved employee IDs for admin/collector provisioning.
# Used only by the separately guarded Super Admin bootstrap/recovery process
# and approved legacy-identity verification. Routine staff provisioning by a
# signed-in Super Admin does not require invitee IDs to be listed here.
# Example: MUNICIPAL_EMPLOYEE_ALLOWLIST=INITIAL-SUPER-ADMIN-EMPLOYEE-ID
MUNICIPAL_EMPLOYEE_ALLOWLIST=

# ---------------------------------------------------------------------------
# IAM — Super Admin Offline Provisioning & Emergency Recovery
# ---------------------------------------------------------------------------
# Used ONLY by manual/offline administrative scripts (never by normal runtime):
#   - python -m server.scripts.bootstrap_super_admin (initial Super Admin setup)
#   - python -m server.scripts.recover_super_admin   (disaster recovery)
#
# Required when running bootstrap or recovery scripts:
MUNICIPAL_SUPER_ADMIN_EMPLOYEE_ID=
MUNICIPAL_SUPER_ADMIN_NAME=
MUNICIPAL_SUPER_ADMIN_LOGIN_ID=
MUNICIPAL_SUPER_ADMIN_EMAIL=
MUNICIPAL_SUPER_ADMIN_PHONE=
#
# Emergency Recovery Authorization:
# Must be set to "YES" ONLY during offline emergency Super Admin account recovery
# after formal municipal approval. Leave unset/empty during normal operation.
MUNICIPAL_IAM_RECOVERY_APPROVED=

# ---------------------------------------------------------------------------
# Municipality branding
# ---------------------------------------------------------------------------
MUNICIPALITY_NAME="Dhule Municipal Waste Management"
MUNICIPALITY_NAME_MR="धुळे महानगरपालिका स्वच्छता व्यवस्थापन"
FRONTEND_URL=https://ecopulse-ai-frontend.onrender.com
TRACKING_PREFIX=DHL-
