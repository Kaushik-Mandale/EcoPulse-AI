# ===================================================
# EcoPulse AI / CitySwap Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ===================================================

# General Application Configuration
PROJECT_NAME="EcoPulse AI API"
VERSION=1.0.0
# Backward-compatible alias: PROJECT_VERSION=1.0.0
ENV=development
# Backward-compatible alias: ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL in production; SQLite local fallback if unset)
DATABASE_URL=postgresql://username@your-db-host.example:5432/ecopulse?sslmode=require

# Security (Required in production - minimum 32 random characters)
SECRET_KEY=replace_with_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Comma-separated list of allowed frontend origins; required in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://ecopulse-ai-frontend.onrender.com
# Backward-compatible alias: BACKEND_CORS_ORIGINS=http://localhost:5173

# Storage Configuration
# MEDIA_STORAGE_BACKEND: 'local' (development/testing) or 'r2' (Cloudflare R2 for production)
MEDIA_STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Cloudflare R2 Object Storage (Required when MEDIA_STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ecopulse-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional custom endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if unset)
R2_ENDPOINT_URL=
# Optional public CDN / custom domain (if unset, secure 7-day presigned URLs are generated by default)
R2_PUBLIC_URL=

# Supabase Storage (Required when MEDIA_STORAGE_BACKEND=supabase)
# Copy these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Bucket name (must already exist in Supabase Storage; keep private)
SUPABASE_STORAGE_BUCKET=complaint-images
# Signed URL expiry in seconds (default: 900 = 15 minutes)
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# Primary WhatsApp Provider (Meta Cloud API)
WHATSAPP_PROVIDER=meta
# Required in production for Meta webhook POST signature verification:
META_APP_SECRET=
# Required in production for sending outbound WhatsApp replies/alerts:
WHATSAPP_TOKEN=
# Required in production for Meta Graph API messaging URL:
WHATSAPP_PHONE_NUMBER_ID=
# Required for Meta webhook GET verification handshake:
WHATSAPP_VERIFY_TOKEN=your_private_unpredictable_verify_token
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_GRAPH_API_VERSION=v20.0

# Optional Twilio WhatsApp Provider (Active ONLY when WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=
# TWILIO_WEBHOOK_URL=https://your-public-domain.example/api/whatsapp/twilio-webhook
